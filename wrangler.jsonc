// Publicação no Cloudflare: o simulador é um site estático (a pasta dist/, gerada por `npm run build`).
// Não há código de Worker: o Cloudflare só serve os arquivos.
// O envio é feito pelo Cloudflare a cada commit na master (Workers Builds, ligado ao repositório no GitHub):
//   comando de build:  npm run build
//   comando de deploy: npx wrangler deploy
{
  "name": "gus-off-grid",
  // Conta Cloudflare do Gustavo. Não é segredo; fixa a conta na publicação pelo GitHub Actions (que só tem o token).
  "account_id": "4ff10b191d39f43259ed595b9bc2e551",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "assets": {
    "directory": "./dist"
  }
}
